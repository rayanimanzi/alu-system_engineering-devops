#!/usr/bin/env bash
# Installs HAProxy and load balances traffic to web-01 and web-02 using roundrobin
apt-get -y update
apt-get -y install haproxy
echo "ENABLED=1" >> /etc/default/haproxy
if ! grep -q "backend web_servers" /etc/haproxy/haproxy.cfg; then
cat >> /etc/haproxy/haproxy.cfg << 'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    mode http
    balance roundrobin
    server 7347-web-01 16.61.244.101:80 check
    server 7347-web-02 18.170.224.139:80 check
EOF
fi
service haproxy restart
